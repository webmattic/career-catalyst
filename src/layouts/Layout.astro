---
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-YD1JPD4YMD';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
const { title = "Pragnya Consultancy - ₹99 Stream Clarity Webinar", description = "A practical ₹99 webinar for Mumbai parents who want to choose the right stream using aptitude, personality, interest, and learning-style signals." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-NTBH2GRG');</script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <meta name="theme-color" content="#001f3f" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" type="image/webp" href="/images/webinar-3.webp" />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    {gaMeasurementId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    )}
    {metaPixelId && (
      <script is:inline define:vars={{ metaPixelId }}>
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = true;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', metaPixelId);
        window.fbq('track', 'PageView');
      </script>
    )}
    {gaMeasurementId && (
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaMeasurementId);
      </script>
    )}
    <title>{title}</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NTBH2GRG"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.trackLandingEvent = function (eventName, detail = {}) {
        const payload = { event: eventName, ...detail };
        window.dataLayer.push(payload);

        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, detail);
        }

        if (typeof window.fbq === 'function' && eventName !== 'PageView') {
          window.fbq('trackCustom', eventName, detail);
        }
      };

      window.trackLandingEvent('PageView', { page: 'webinar-landing' });
      window.trackLandingEvent('ViewContent', { page: 'webinar-landing' });

      document.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-track-event]');
        if (!trigger) {
          return;
        }

        window.trackLandingEvent(trigger.dataset.trackEvent, {
          placement: trigger.dataset.trackPlacement || 'unknown',
        });
      });
    </script>
  </body>
</html>
