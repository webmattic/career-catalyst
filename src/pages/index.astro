---
import Layout from '../layouts/Layout.astro';
import MarketingTopBar from '../components/sections/MarketingTopBar.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import WebinarDetails from '../components/sections/WebinarDetails.astro';
import Decision from '../components/sections/Decision.astro';
import Framework from '../components/sections/Framework.astro';
import Coverage from '../components/sections/Coverage.astro';
import Value from '../components/sections/Value.astro';
import Expert from '../components/sections/Expert.astro';
import WhyNow from '../components/sections/WhyNow.astro';
import RegistrationForm from '../components/sections/RegistrationForm.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import MobileStickyCTA from '../components/sections/MobileStickyCTA.astro';
---

<Layout
  title="Pragnya Consultancy - ₹99 Stream Clarity Webinar for Mumbai Parents"
  description="A practical ₹99 live webinar for Mumbai parents of Class 8, 9 and 10 students who want calmer, aptitude-informed stream decisions before Class 10 pressure peaks."
>
  <MarketingTopBar />
  <SiteHeader />

  <main>
    <Hero />
    <WebinarDetails />
    <Decision />
    <Framework />
    <Coverage />
    <Value />
    <Expert />
    <WhyNow />
    <RegistrationForm />
    <FAQ />
    <FinalCTA />
  </main>

  <SiteFooter />
  <MobileStickyCTA />
</Layout>
