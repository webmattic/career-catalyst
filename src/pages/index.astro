---
import Layout from '../layouts/Layout.astro';
import MarketingTopBar from '../components/sections/MarketingTopBar.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import Decision from '../components/sections/Decision.astro';
import Coverage from '../components/sections/Coverage.astro';
import Value from '../components/sections/Value.astro';
import Framework from '../components/sections/Framework.astro';
import Expert from '../components/sections/Expert.astro';
import RegistrationForm from '../components/sections/RegistrationForm.astro';
import Packages from '../components/sections/Packages.astro';
import FAQ from '../components/sections/FAQ.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import MobileStickyCTA from '../components/sections/MobileStickyCTA.astro';
---

<Layout
  title="Pragnya Consultancy - Class 8-10 Stream Clarity Webinar"
  description="A practical Rs.99 webinar for Mumbai parents of Class 8-10 students who want to choose Science, Commerce, or Humanities using aptitude, personality, interest, and learning-style signals."
>
  <MarketingTopBar />
  <SiteHeader />

  <main>
    <Hero />
    <Decision />
    <Coverage />
    <Value />
    <Framework />
    <Expert />
    <RegistrationForm />
    <!-- <Packages /> -->
    <FAQ />
  </main>

  <SiteFooter />
  <MobileStickyCTA />
</Layout>
