---
interface Props {
  name:
    | 'calendar'
    | 'clock'
    | 'video'
    | 'wallet'
    | 'users'
    | 'brain'
    | 'sparkles'
    | 'compass'
    | 'handshake'
    | 'book-open'
    | 'shield'
    | 'message-circle'
    | 'check-circle'
    | 'triangle-alert'
    | 'school'
    | 'star'
    | 'heart-handshake'
    | 'badge-check'
    | 'robot'
    | 'award';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'calendar' && (
    <>
      <path d="M8 2v4" />
      <path d="M16 2v4" />
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <path d="M3 10h18" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'video' && (
    <>
      <rect x="3" y="6" width="13" height="12" rx="2" />
      <path d="m16 10 5-3v10l-5-3z" />
    </>
  )}
  {name === 'wallet' && (
    <>
