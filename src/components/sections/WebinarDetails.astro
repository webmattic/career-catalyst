---
import '../../styles/webinar-details.css';
import { webinarConfig } from '../../data/webinar.js';
import OutlineIcon from '../shared/OutlineIcon.astro';
---

<section class="webinar-details-section">
  <div class="container">
    <div class="details-card">
      <div class="details-copy">
        <p class="label muted">Live webinar details</p>
        <h2>Everything a parent needs before reserving a seat</h2>
      </div>
      <dl class="details-grid">
        <div>
          <span class="details-icon"><OutlineIcon name="calendar" size={18} /></span>
          <dt>Date</dt>
          <dd>{webinarConfig.dateLabel}</dd>
        </div>
        <div>
          <span class="details-icon"><OutlineIcon name="clock" size={18} /></span>
          <dt>Time</dt>
          <dd>{webinarConfig.timeLabel}</dd>
        </div>
        <div>
          <span class="details-icon"><OutlineIcon name="message-circle" size={18} /></span>
          <dt>Duration</dt>
          <dd>{webinarConfig.durationLabel}</dd>
        </div>
        <div>
          <span class="details-icon"><OutlineIcon name="video" size={18} /></span>
          <dt>Platform</dt>
          <dd>{webinarConfig.platformLabel}</dd>
        </div>
        <div>
          <span class="details-icon"><OutlineIcon name="wallet" size={18} /></span>
          <dt>Fee</dt>
          <dd>{webinarConfig.displayPrice}</dd>
        </div>
        <div>
          <span class="details-icon"><OutlineIcon name="users" size={18} /></span>
          <dt>Who should attend</dt>
          <dd>{webinarConfig.audienceLabel}</dd>
        </div>
      </dl>
      <p class="details-note">
        Your child may sit with you during the session, but the webinar is primarily designed for parents in the
        Mumbai school context.
      </p>
      <p class="details-reassurance">Live Q&amp;A keeps the session practical, relevant, and parent-focused from start to finish.</p>
    </div>
  </div>
</section>
