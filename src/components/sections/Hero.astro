---
import '../../styles/hero.css';
import { webinarConfig } from '../../data/webinar.js';

const webinarHref = '#webinar-form';
---

<section id="webinar" class="hero-section">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="label">For Mumbai Class 8–10 parents</p>
      <h1>Confused Between Science, Commerce or Arts? Make the Right Stream Decision Before Class 10 Pressure Peaks.</h1>
      <p class="hero-lede">
        A practical live webinar for Mumbai parents at {webinarConfig.displayPrice} to understand their child’s aptitude signals, personality fit,
        study style and stream direction before choosing the wrong path under pressure.
      </p>
      <div class="hero-actions">
        <a href={webinarHref} class="button button-gold" data-track-event="HeroCTA_Click" data-track-placement="hero">
          Reserve My Parent Seat for {webinarConfig.displayPrice}
        </a>
      </div>
      <p class="hero-payment-note">Instant payment via UPI, GPay, PhonePe or card. Webinar link sent on WhatsApp after confirmation.</p>
      <div class="trust-line" aria-label="Webinar trust signals">
        <span>Led live by Mehal Chhaya</span>
        <span>27+ years in education</span>
        <span>75-minute session + parent Q&amp;A</span>
      </div>
    </div>
    <div class="hero-media">
      <picture>
        <source srcset="/images/webinar-3.webp" type="image/webp" />
        <img src="/images/webinar-3.png" alt="Parent and student attending a stream clarity webinar together" loading="eager" width="1200" height="900" fetchpriority="high" />
      </picture>
    </div>
  </div>
</section>
