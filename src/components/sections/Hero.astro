---
import '../../styles/hero.css';
import { webinarConfig } from '../../data/webinar.js';
import OutlineIcon from '../shared/OutlineIcon.astro';

const webinarHref = '#registration-form';
---

<section id="hero-section" class="hero-section">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="label">For Mumbai Class 8–10 parents</p>
      <h1>Confused Between Science, Commerce or Arts? Make the Right Stream Decision Before Class 10 Pressure Peaks.</h1>
      <p class="hero-lede">
        A practical {webinarConfig.displayPrice} live webinar for Mumbai parents of Class 8–10 students to understand aptitude, personality,
        subject fit and career direction before choosing a stream.
      </p>
      <div class="hero-actions">
        <a href={webinarHref} class="button button-gold" data-track-event="hero_cta_click" data-track-placement="hero">
          Reserve My Seat for {webinarConfig.displayPrice}
        </a>
        <a href="#outcomes" class="button button-ghost" data-track-event="hero_secondary_cta_click" data-track-placement="hero-secondary">
          See What You Will Learn
        </a>
      </div>
      <p class="hero-payment-note">
        Submit your details first. On the next step, scan the {webinarConfig.displayPrice} UPI QR using GPay, PhonePe,
        Paytm, BHIM or any UPI app. Your webinar confirmation will be sent on WhatsApp after payment verification.
      </p>
      <div class="trust-line" aria-label="Webinar trust signals">
        <span><OutlineIcon name="badge-check" size={15} /> Guided by Mehal Chhaya</span>
        <span><OutlineIcon name="school" size={15} /> 27+ years in education</span>
        <span><OutlineIcon name="message-circle" size={15} /> Parent-focused career clarity session</span>
      </div>
    </div>
    <div class="hero-media">
      <picture>
        <source srcset="/images/webinar-3.webp" type="image/webp" />
        <img src="/images/webinar-3.png" alt="Parent and student attending a stream clarity webinar together" loading="eager" width="1200" height="900" fetchpriority="high" />
      </picture>
    </div>
  </div>
</section>
