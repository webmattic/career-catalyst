---
import '../../styles/value.css';
import { webinarConfig } from '../../data/webinar.js';
---

<section class="value-section section-pad">
  <div class="container value-panel">
    <div>
      <p class="label gold">What your {webinarConfig.displayPrice} registration includes</p>
      <h2>What your webinar registration includes</h2>
    </div>
    <ul class="value-list">
      <li><strong>Live expert-led webinar</strong> for Class 8–10 parents.</li>
      <li><strong>Stream selection framework</strong> explained in simple language.</li>
      <li><strong>Parent Q&amp;A session</strong> during the live webinar.</li>
      <li><strong>Career discussion checklist for parents</strong> after registration.</li>
      <li><strong>WhatsApp confirmation</strong> after payment.</li>
      <li><strong>Optional next-step assessment guidance</strong> after the webinar.</li>
    </ul>
  </div>
</section>
