---
import '../../styles/registration.css';
import { biggestConcernOptions, upiPaymentConfig, webinarConfig } from '../../data/webinar.js';
import OutlineIcon from '../shared/OutlineIcon.astro';

const submitCopy = 'Continue to ₹99 UPI Payment';
const paymentEnabledCopy =
  'Submit your details first. On the next step, scan the ₹99 UPI QR using GPay, PhonePe, Paytm, BHIM or any UPI app. Your webinar confirmation will be sent on WhatsApp after payment verification.';
const fallbackCopy = 'Your details have been saved. Secure UPI payment is temporarily unavailable. Please try again shortly.';
---

<section id="registration-form" class="registration-section section-pad">
  <div class="container registration-panel">
    <div class="registration-copy">
      <p class="label gold">Reserve your webinar seat for {webinarConfig.displayPrice}</p>
      <h2>Enter your details and complete your ₹99 UPI payment</h2>
      <p>{paymentEnabledCopy}</p>
      <div class="registration-highlights">
        <span>{webinarConfig.dateLabel}</span>
        <span>{webinarConfig.timeLabel}</span>
        <span>{webinarConfig.platformLabel}</span>
      </div>
      <div class="payment-logo-row" aria-label="Supported UPI payment options">
        <span>Pay using</span>
        <img src="/images/gpay.webp" alt="Google Pay supported" loading="lazy" width="92" height="36" />
        <img src="/images/upi.webp" alt="UPI supported" loading="lazy" width="92" height="36" />
      </div>
    </div>

    <form class="lead-form" data-webinar-form novalidate>
      <input name="source" type="hidden" value={webinarConfig.registrationSource} />
      <input name="area_locality" type="hidden" value="" />
      <input name="parent_name" type="text" autocomplete="name" placeholder="Parent Name" required />
      <input
        name="whatsapp"
        type="tel"
        inputmode="numeric"
        autocomplete="tel"
        placeholder="WhatsApp Number"
        pattern="[6-9][0-9]{9}"
        required
      />
      <select name="class" required>
        <option value="">Child's Class</option>
        <option>Class 8</option>
        <option>Class 9</option>
        <option>Class 10</option>
      </select>
      <select name="preferred_batch" required>
        <option value="">Preferred Webinar Batch</option>
        <option value={webinarConfig.preferredBatchLabel}>{webinarConfig.preferredBatchLabel}</option>
      </select>
      <input name="email" type="email" autocomplete="email" placeholder="Email Address (optional)" />
      <select name="child_board">
        <option value="">Child's Board (optional)</option>
        <option>SSC</option>
        <option>CBSE</option>
        <option>ICSE</option>
        <option>IGCSE</option>
        <option>Other</option>
      </select>
      <select name="biggest_concern">
        <option value="">Biggest concern right now (optional)</option>
        {biggestConcernOptions.map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
      <div class="payment-trust-row" aria-label="Payment trust signals">
        <span><OutlineIcon name="shield" size={16} /> Secure UPI payment</span>
        <span><OutlineIcon name="wallet" size={16} /> GPay, PhonePe, Paytm, BHIM and all UPI apps supported</span>
        <span><OutlineIcon name="video" size={16} /> Webinar confirmation sent on WhatsApp after verification</span>
        <span><OutlineIcon name="message-circle" size={16} /> WhatsApp support available if payment help is needed</span>
      </div>
      <button type="submit" class="button button-gold" data-submit-button data-default-label={submitCopy}>
        {submitCopy}
      </button>
      <p class="lead-form-reassurance">Your seat will be confirmed on WhatsApp after successful ₹99 UPI payment verification.</p>
      <p class="lead-form-note">{paymentEnabledCopy}</p>
      <p class="lead-form-privacy">
        We will use your details only for webinar confirmation, reminders and career guidance communication.
      </p>
      <a class="registration-whatsapp-link" href="https://wa.me/919820800752?text=Hello%20Pragnya%20Consultancy%2C%20I%20am%20interested%20in%20the%20%E2%82%B999%20Stream%20Clarity%20Webinar%20for%20my%20child.%20Please%20share%20more%20details." target="_blank" rel="noopener">
        Prefer to ask a question first? Message us on WhatsApp.
      </a>
      <div class="form-status" data-form-status hidden aria-live="polite"></div>
    </form>

  </div>
</section>

<div class="upi-modal" data-upi-modal hidden>
  <div class="upi-modal-backdrop" data-upi-close></div>
  <section class="upi-modal-card" role="dialog" aria-modal="true" aria-labelledby="upi-modal-title">
    <button type="button" class="upi-modal-close" data-upi-close aria-label="Close payment step">×</button>
    <p class="label gold">Step 2</p>
    <h3 id="upi-modal-title">Complete Your ₹99 UPI Payment</h3>
    <p class="upi-modal-copy">Scan the GPay / UPI QR to complete your ₹99 payment.</p>
    <div class="upi-qr-shell">
      {upiPaymentConfig.qrReady ? (
        <img
          src={upiPaymentConfig.qrImagePath}
          alt="Pragnya Consultancy UPI payment QR"
          width="240"
          height="240"
          loading="lazy"
        />
      ) : (
        <div class="upi-qr-placeholder">
          <strong>GPay / UPI QR placeholder</strong>
          <p>TODO: Replace with final verified Pragnya Consultancy UPI QR before production launch.</p>
        </div>
      )}
    </div>
  </section>
</div>

<script is:inline define:vars={{ submitCopy, fallbackCopy }}>
  const form = document.querySelector('[data-webinar-form]');
  const statusBox = form?.querySelector('[data-form-status]');
  const submitButton = form?.querySelector('[data-submit-button]');
  const upiModal = document.querySelector('[data-upi-modal]');
  const upiCloseTriggers = document.querySelectorAll('[data-upi-close]');
  let didTrackFormStart = false;

  const track = (eventName, detail = {}) => {
    window.trackLandingEvent?.(eventName, detail);
  };

  const readJsonResponse = async (response, fallbackMessage) => {
    const contentType = response.headers.get('content-type') || '';
    if (!contentType.includes('application/json')) {
      throw new Error(fallbackMessage);
    }

    const payload = await response.json().catch(() => null);
    if (!payload) {
      throw new Error(fallbackMessage);
    }

    if (!response.ok) {
      throw new Error(payload.error || fallbackMessage);
    }

    return payload;
  };

  const setStatus = (state, message) => {
    if (!statusBox) {
      return;
    }

    statusBox.hidden = false;
    statusBox.dataset.state = state;
    statusBox.textContent = message;
  };

  const setLoading = (isLoading) => {
    if (!submitButton) {
      return;
    }

    submitButton.disabled = isLoading;
    submitButton.textContent = isLoading ? 'Preparing UPI payment step...' : submitCopy;
  };

  const toPayload = (formData) => ({
    parent_name: formData.get('parent_name'),
    whatsapp: formData.get('whatsapp'),
    email: formData.get('email'),
    class: formData.get('class'),
    preferred_batch: formData.get('preferred_batch'),
    child_board: formData.get('child_board'),
    area_locality: formData.get('area_locality'),
    biggest_concern: formData.get('biggest_concern'),
    source: formData.get('source'),
  });

  const revealUpiStep = (leadData) => {
    upiModal?.removeAttribute('hidden');
    document.body.classList.add('upi-modal-open');
    track('payment_started', {
      leadId: leadData.leadId,
      source: 'upi_qr',
    });
    track('upi_qr_revealed', {
      leadId: leadData.leadId,
      source: 'upi_qr',
    });
  };

  const closeUpiStep = () => {
    upiModal?.setAttribute('hidden', 'hidden');
    document.body.classList.remove('upi-modal-open');
  };

  track('form_view', {
    formId: 'webinar-form',
  });

  form?.addEventListener(
    'focusin',
    () => {
      if (didTrackFormStart) {
        return;
      }

      didTrackFormStart = true;
      track('form_start', { formId: 'webinar-form' });
    },
    { once: true }
  );

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (statusBox) {
      statusBox.hidden = true;
    }

    if (!form.reportValidity()) {
      return;
    }

    const formData = new FormData(form);
    const payload = toPayload(formData);
    setLoading(true);

    try {
      const leadResponse = await fetch('/api/leads', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const leadData = await readJsonResponse(leadResponse, 'Registration could not be started. Please try again or message us on WhatsApp.');

      track('lead_created', {
        leadId: leadData.leadId,
        mode: leadData.mode,
      });

      if (leadData.mode !== 'upi_qr') {
        form.reset();
        setStatus('success', leadData.message || fallbackCopy);
        return;
      }

      const paymentStartResponse = await fetch('/api/payments/start', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          accept: 'application/json',
        },
        body: JSON.stringify({
          leadId: leadData.leadId,
        }),
      });

      await readJsonResponse(paymentStartResponse, 'Payment step could not be opened. Please try again or message us on WhatsApp.');

      setStatus('success', 'Your details have been saved. Complete Step 2 using the ₹99 UPI QR below.');
      revealUpiStep(leadData);
    } catch (error) {
      track('payment_failed', {
        message: error.message || 'unknown_error',
      });
      setStatus('error', error.message || 'Something went wrong. Please try again.');
    } finally {
      setLoading(false);
    }
  });

  upiCloseTriggers.forEach((trigger) => {
    trigger.addEventListener('click', closeUpiStep);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeUpiStep();
    }
  });
</script>
