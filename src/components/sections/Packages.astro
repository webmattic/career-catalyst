---
import '../../styles/packages.css';

const webinarHref = '#registration-form';
---

<section id="packages" class="packages-section section-pad">
  <div class="container">
    <div class="section-heading centered">
      <p class="label muted">After the webinar</p>
      <h2>Optional next-step guidance after the webinar.</h2>
    </div>
    <div class="package-grid">
      <article class="package-card">
        <div class="package-price">
          <span>Next-step pathway</span>
          <strong>Optional</strong>
        </div>
        <h3>Assessment guidance after the webinar</h3>
        <ul>
          <li>Parents who want deeper clarity can choose an optional pathway later</li>
          <li>Assessment and counselling decisions stay outside the live webinar page</li>
          <li>The webinar itself remains the first step for stream clarity</li>
        </ul>
        <a href={webinarHref} class="button button-outline">Start with ₹99 webinar</a>
      </article>
      <article class="package-card package-featured">
        <div class="package-tag">Webinar-first journey</div>
        <div class="package-price">
          <span>After the session</span>
          <strong>Optional</strong>
        </div>
        <h3>Parents can decide on deeper support only after attending</h3>
        <ul>
          <li>No backend package pricing is shown on the live landing page</li>
          <li>Optional scientific assessment and personal counselling can be discussed later</li>
          <li>The conversion goal here remains a ₹99 webinar seat reservation</li>
        </ul>
        <a href={webinarHref} class="button button-gold">Reserve My Seat for ₹99</a>
      </article>
    </div>
  </div>
</section>
