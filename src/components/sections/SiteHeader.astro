---
import '../../styles/header.css';
import { webinarConfig } from '../../data/webinar.js';
import OutlineIcon from '../shared/OutlineIcon.astro';

const webinarHref = '#registration-form';
---

<header class="site-header">
  <div class="container header-shell">
    <a href="/" class="brand" aria-label="Pragnya Consultancy home">
      <span class="brand-icon">P</span>
      <span class="brand-text">Pragnya Consultancy</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="#hero-section"><OutlineIcon name="video" size={14} /> <span>Webinar</span></a>
      <a href="#outcomes"><OutlineIcon name="compass" size={14} /> <span>Outcomes</span></a>
      <a href="#expert"><OutlineIcon name="badge-check" size={14} /> <span>Expert</span></a>
      <a href="#faq"><OutlineIcon name="message-circle" size={14} /> <span>FAQ</span></a>
    </nav>
    <a href={webinarHref} class="nav-cta" data-track-event="header_cta_click" data-track-placement="header">Reserve My Seat for {webinarConfig.displayPrice}</a>
  </div>
</header>
