---
import '../../styles/header.css';
import { webinarConfig } from '../../data/webinar.js';

const webinarHref = '#webinar-form';
---

<header class="site-header">
  <div class="container header-shell">
    <a href="/" class="brand" aria-label="Pragnya Consultancy home">
      <span class="brand-icon">P</span>
      <span class="brand-text">Pragnya Consultancy</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="#webinar">Webinar</a>
      <a href="#outcomes">Outcomes</a>
      <a href="#expert">Expert</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href={webinarHref} class="nav-cta" data-track-event="HeroCTA_Click" data-track-placement="header">Reserve My Parent Seat for {webinarConfig.displayPrice}</a>
  </div>
</header>
