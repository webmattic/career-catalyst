---
import '../../styles/mobile-sticky.css';
import { webinarConfig } from '../../data/webinar.js';

const webinarHref = '#webinar-form';
---

<div class="floating-actions" aria-label="Quick actions">
  <a
    href="https://wa.me/919820800752"
    class="floating-action floating-action-whatsapp"
    target="_blank"
    rel="noopener"
    aria-label="Message us on WhatsApp"
  >
    <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
      <path
        fill="currentColor"
        d="M19.11 17.26c-.3-.15-1.76-.87-2.03-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.94 1.16-.17.2-.35.22-.65.08-.3-.15-1.28-.47-2.43-1.5-.9-.8-1.51-1.78-1.69-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.91-2.19-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.08-.8.37-.27.3-1.04 1.01-1.04 2.47s1.07 2.87 1.22 3.07c.15.2 2.09 3.2 5.06 4.48.71.31 1.27.5 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.34Z"
      />
      <path
        fill="currentColor"
        d="M27.26 4.73A15.84 15.84 0 0 0 16.02.08C7.3.08.21 7.17.21 15.89c0 2.79.73 5.52 2.11 7.92L.08 31.92l8.3-2.18a15.73 15.73 0 0 0 7.51 1.92h.01c8.72 0 15.82-7.1 15.82-15.82 0-4.23-1.65-8.2-4.46-11.11Zm-11.37 24.2h-.01a13.1 13.1 0 0 1-6.67-1.82l-.48-.28-4.93 1.3 1.32-4.8-.31-.49a13.1 13.1 0 0 1-2.03-6.95c0-7.22 5.88-13.1 13.12-13.1 3.5 0 6.79 1.36 9.26 3.83a13.01 13.01 0 0 1 3.84 9.28c0 7.23-5.88 13.11-13.11 13.11Z"
      />
    </svg>
  </a>
  <button type="button" class="floating-action floating-action-top" data-scroll-top aria-label="Scroll to top">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 5l-7 7 1.41 1.41L11 8.83V20h2V8.83l4.59 4.58L19 12z" fill="currentColor" />
    </svg>
  </button>
</div>

<a href={webinarHref} class="mobile-sticky-cta" data-track-event="sticky_cta_click" data-track-placement="sticky">
  Reserve Seat - {webinarConfig.displayPrice}
</a>

<script is:inline>
  const scrollTopButton = document.querySelector('[data-scroll-top]');
  scrollTopButton?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
