---
import '../../styles/faq.css';
import { webinarFaqs } from '../../data/webinar.js';
---

<section id="faq" class="faq-section section-pad">
  <div class="container">
    <div class="section-heading centered">
      <p class="label muted">Common questions</p>
      <h2>Before you reserve your seat</h2>
    </div>
    <div class="faq-list">
      {webinarFaqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
