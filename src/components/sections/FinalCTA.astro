---
import '../../styles/final-cta.css';
import { webinarConfig } from '../../data/webinar.js';
import OutlineIcon from '../shared/OutlineIcon.astro';
---

<section class="final-cta-section section-pad">
  <div class="container final-cta-card">
    <div class="final-cta-content">
      <p class="label gold">Final call to action</p>
      <h2>Do not wait until stream selection becomes a last-minute panic decision.</h2>
      <p>
        Class 8 to 10 is the right time to understand your child’s strengths, interests and study style before Science,
        Commerce or Arts becomes a rushed decision.
      </p>
    </div>
    <div class="final-cta-actions">
      <div class="final-cta-proof" aria-label="Registration reassurance">
        <span><OutlineIcon name="badge-check" size={17} /> {webinarConfig.displayPrice} live webinar seat</span>
        <span><OutlineIcon name="message-circle" size={17} /> Parent-focused guidance</span>
        <span><OutlineIcon name="video" size={17} /> Google Meet confirmation on WhatsApp</span>
      </div>
      <a href="#registration-form" class="button button-gold" data-track-event="final_cta_click" data-track-placement="final-cta">
        Reserve My Seat for {webinarConfig.displayPrice}
      </a>
      <p class="final-cta-microcopy">Takes less than a minute. Confirmation is sent after UPI payment verification.</p>
    </div>
  </div>
</section>
