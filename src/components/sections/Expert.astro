---
import '../../styles/expert.css';
---

<section id="expert" class="expert-section section-pad">
  <div class="container expert-card">
    <div class="expert-credential">
      <img src="/images/mehal-3.jpg" alt="Mehal Chhaya credentials and career counselling profile" loading="lazy" />
    </div>
    <div class="expert-copy">
      <p class="label muted">Expert guidance</p>
      <h2>Meet Mehal Chhaya</h2>
      <p>
        Mehal Chhaya helps families interpret assessment data in the context of the child's temperament, academic
        stage, and realistic career direction. Her role is to convert a report into a calm, practical parent-student
        decision.
      </p>
      <div class="expert-badges">
        <span>27+ years in education</span>
        <span>Career counselling</span>
        <span>Parent-student discussion</span>
        <span>Aptitude guidance</span>
      </div>
    </div>
  </div>
</section>
