---
import '../../styles/expert.css';
import OutlineIcon from '../shared/OutlineIcon.astro';
---

<section id="expert" class="expert-section section-pad">
  <div class="container expert-card">
    <div class="expert-credential">
      <picture>
        <source srcset="/images/mehal-3.webp" type="image/webp" />
        <img src="/images/mehal-3.jpg" alt="Mehal Chhaya credentials and career counselling profile" loading="lazy" width="800" height="1201" />
      </picture>
    </div>
    <div class="expert-copy">
      <p class="label muted">Counsellor authority</p>
      <h2>Guided by Mehal Chhaya</h2>
      <p>
        Career counsellor and education professional with 27+ years of experience helping students and parents make
        clearer academic decisions.
      </p>
      <div class="expert-badges">
        <span>27+ years in education</span>
        <span>Career counselling and parent-student guidance experience</span>
        <span>Focused on aptitude, personality and stream-selection clarity</span>
        <span>Practical guidance for Indian school and college pathways</span>
      </div>
      <div class="expert-trust-note">
        <span class="expert-trust-icon"><OutlineIcon name="badge-check" size={18} /></span>
        <p>Her role in this webinar is to help parents think more clearly, more calmly, and more responsibly before stream pressure peaks.</p>
      </div>
      <p class="expert-transition">
        After the webinar, parents who want deeper clarity can choose an optional scientific assessment and personal
        counselling pathway.
      </p>
    </div>
  </div>
</section>
